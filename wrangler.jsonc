{
  "name": "english-steps",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./docs",
    "run_worker_first": ["/grade"]
  },
  "ai": { "binding": "AI" },
  "vars": { "ALLOWED_ORIGIN": "https://phuvohoang.github.io" },
  "ratelimits": [
    { "name": "GRADE_LIMIT", "namespace_id": "1901", "simple": { "limit": 6, "period": 60 } }
  ]
}
